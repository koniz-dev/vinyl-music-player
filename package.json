{
  "name": "vinyl-music-player",
  "version": "0.0.1",
  "description": "A beautiful vinyl music player with synchronized lyrics and WebM video export functionality",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "npx http-server -a 127.0.0.1 -p 3000 -o -c-1",
    "app": "node scripts/open-local.mjs",
    "app:stop": "node scripts/stop-local.mjs",
    "start": "npx http-server -a 127.0.0.1 -p 3000 -c-1",
    "build": "echo 'No build process needed for static HTML'",
    "preview": "npx http-server -a 127.0.0.1 -p 3000 -c-1",
    "serve": "npx http-server -a 127.0.0.1 -p 8080 -c-1",
    "test": "npm run test:syntax && npm run test:events && npm run test:parsers && npm run test:translation && npm run test:pwa && npm run test:ui",
    "test:syntax": "find js test scripts -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check",
    "test:events": "node test/events.mjs",
    "test:parsers": "node test/parsers.mjs",
    "test:pwa": "node test/pwa.mjs",
    "test:translation": "node test/translation-worker.mjs",
    "test:ui": "node test/ui-shell.mjs"
  },
  "keywords": [
    "music",
    "player",
    "vinyl",
    "html",
    "css",
    "javascript",
    "audio",
    "video",
    "export",
    "lyrics",
    "pwa"
  ],
  "author": "koniz-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/koniz-dev/vinyl-music-player.git"
  },
  "homepage": "https://github.com/koniz-dev/vinyl-music-player#readme",
  "bugs": {
    "url": "https://github.com/koniz-dev/vinyl-music-player/issues"
  },
  "devDependencies": {
    "http-server": "^14.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
